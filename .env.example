# Base URL of the optimizer API.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# There is deliberately no default sub-account. The id always comes from the
# `locationId` query parameter — supplied by a merge field on the HighLevel
# Custom Menu Link, or typed into the URL when running standalone. A build-time
# fallback would turn a missing merge field from a visible error into silently
# serving whichever sub-account was compiled in.
